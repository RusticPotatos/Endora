# {{ ansible_managed }}
# Values for Endora's docker-compose.yml. No secrets: the node keeps those in its database.
ENDORA_MODEL_URL={{ endora_model_url }}
ENDORA_MODEL={{ endora_model }}
ENDORA_TIME_ZONE={{ endora_time_zone }}
{% if endora_data_dir %}
ENDORA_DATA_DIR={{ endora_data_dir }}
{% endif %}
{% if endora_hq | bool %}
ENDORA_HQ_URL=http://hq:8790
ENDORA_HQ_DEMO={{ '1' if endora_hq_demo | bool else '0' }}
{% endif %}
{% if endora_sound | bool %}
ENDORA_SOUND_URL=http://sound:8791
{% endif %}
{% if endora_sound_airplay2 | bool %}
SOUND_AIRPLAY2=1
SOUND_AIRPLAY2_PARENT={{ endora_sound_airplay2_parent }}
SOUND_AIRPLAY2_SUBNET={{ endora_sound_airplay2_subnet }}
SOUND_AIRPLAY2_GATEWAY={{ endora_sound_airplay2_gateway }}
SOUND_AIRPLAY2_IP={{ endora_sound_airplay2_ip }}
{% if endora_sound_airplay2_mac %}
SOUND_AIRPLAY2_MAC={{ endora_sound_airplay2_mac }}
{% endif %}
{% if endora_sound_airplay2_network %}
SOUND_AIRPLAY2_NETWORK={{ endora_sound_airplay2_network }}
SOUND_AIRPLAY2_SHARED=true
{% endif %}
SOUND_AIRPLAY2_HOSTNAME={{ endora_sound_airplay2_hostname }}
SOUND_AIRPLAY2_LATENCY={{ endora_sound_airplay2_latency }}
{% endif %}
{% if endora_vault_url %}
ENDORA_VAULT_URL={{ endora_vault_url }}
{% endif %}
{% if endora_passkey_rp_id %}
ENDORA_PASSKEY_RP_ID={{ endora_passkey_rp_id }}
{% endif %}
{% if endora_brain_dir %}
ENDORA_BRAIN_DIR={{ endora_brain_dir }}
{% endif %}
{% if endora_mail_dir %}
ENDORA_MAIL_DIR={{ endora_mail_dir }}
{% endif %}
{% if endora_lan_dns %}
ENDORA_LAN_DNS={{ endora_lan_dns }}
{% endif %}
{% if endora_hq_tick_seconds | string | length > 0 %}
ENDORA_HQ_TICK_SECONDS={{ endora_hq_tick_seconds }}
{% endif %}
{% if endora_hq_dir %}
ENDORA_HQ_DIR={{ endora_hq_dir }}
{% endif %}
{% if endora_sound_dir %}
ENDORA_SOUND_DIR={{ endora_sound_dir }}
{% endif %}
{% if endora_utc_offset_minutes | string | length > 0 %}
ENDORA_UTC_OFFSET_MINUTES={{ endora_utc_offset_minutes }}
{% endif %}
{% if endora_router_model %}
ENDORA_ROUTER_MODEL={{ endora_router_model }}
{% endif %}
{% if endora_synth_model %}
ENDORA_SYNTH_MODEL={{ endora_synth_model }}
{% endif %}
{% if endora_ansible_nas_repo %}
ENDORA_ANSIBLE_NAS_REPO={{ endora_ansible_nas_repo }}
{% endif %}
{% if endora_ansible_nas_ref %}
ENDORA_ANSIBLE_NAS_REF={{ endora_ansible_nas_ref }}
{% endif %}
{% if endora_lab_retired %}
ENDORA_LAB_RETIRED={{ endora_lab_retired }}
{% endif %}
{% if endora_git_push_key_dir %}
ENDORA_GIT_PUSH_KEY={{ endora_git_push_key_dir }}
{% endif %}
{% if endora_bench_token_dir %}
ENDORA_BENCH_TOKEN={{ endora_bench_token_dir }}
{% endif %}
{% if endora_bench_cap_cents | string | length > 0 %}
ENDORA_BENCH_CAP_CENTS={{ endora_bench_cap_cents }}
{% endif %}
