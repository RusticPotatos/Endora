# The full-system bundle's settings (compose.yaml beside this file). Copy to `.env` and edit.
# Each product's own settings are documented in its file: core/core.env.example, and the
# Console and Audio READMEs. Placeholders only; nothing personal belongs in a tracked file.

# --- Pinned releases (SOURCES.json records where each compose file came from) ----------------
# Core: a released version, or `sha-<commit>`. Must match the commit core/compose.yaml is from.
ENDORA_CORE_VERSION=
# Console: its published build for the pinned compose file (Console publishes `sha-` builds).
CONSOLE_TAG=sha-fd9cf17a588e6226de114852e520a554ad51aa9f
# Audio: its v1.0.0 release.
ENDORA_AUDIO_VERSION=1.0.0

# --- Console in front, at the one browser origin ---------------------------------------------
# People open Console on this port; it passes only the Console contract's routes to Core.
CONSOLE_PORT=8787
CORE_URL=http://node:8787
# Serve HTTPS from Console (recommended: the password and codes cross the network). Put cert.pem
# and key.pem in console/certs/ and uncomment:
#CONSOLE_TLS_CERT=/certs/cert.pem
#CONSOLE_TLS_KEY=/certs/key.pem
# The address people type, if a proxy in front changes it (comma separated).
#CONSOLE_ORIGIN=https://endora.example.com

# Core itself: plain HTTP on the bundle's network, its port on this host's loopback only (for
# setup and for scripts on this host). Not reachable from the LAN.
ENDORA_TLS=0
ENDORA_CORE_BIND=127.0.0.1
ENDORA_CORE_PORT=8786

# --- The model ------------------------------------------------------------------------------
ENDORA_MODEL_URL=http://host.docker.internal:11434/v1
ENDORA_MODEL=qwen2.5:7b

# --- Audio ----------------------------------------------------------------------------------
ENDORA_AUDIO_PORT=8791
# Audio's token (32+ characters; `openssl rand -hex 24`). Empty: Audio makes one on first start.
SOUND_TOKEN=
# Console shows Audio's status (from Audio's own /health) and a link people can open.
AUDIO_URL=http://audio-hub:8791
#AUDIO_PUBLIC_URL=http://192.168.1.10:8791
# The AirPlay 2 door is Audio's own macvlan option, off unless `--profile airplay` and its
# SOUND_AIRPLAY2_* values are set (Audio's README). It needs no other product's network.
SOUND_AIRPLAY2=0

# --- Optional: Core's sound tools use Audio -------------------------------------------------
# Off by default; Audio is independent of Core. Set both to Audio's token above to turn on.
#ENDORA_SOUND_URL=http://audio-hub:8791
#ENDORA_SOUND_TOKEN=

ENDORA_HQ_DEMO=0
ENDORA_TIME_ZONE=
