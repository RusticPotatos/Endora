# The bundle's test settings (test-bundle.sh): only what differs from bundle.env.example, which
# the test reads first. The products' pins (CONSOLE_TAG, ENDORA_AUDIO_VERSION) are therefore set
# in one place, bundle.env.example, and the test runs exactly what a user would.
# Core built from this commit, a stub model, and volume names of the test's own, so `down -v`
# removes only those.
ENDORA_CORE_VERSION=ci
ENDORA_MODEL_URL=http://stub-model:11434/v1
ENDORA_MODEL=stub-model
SOUND_TOKEN=a-placeholder-audio-token-for-the-bundle-test
ENDORA_CORE_DATA_VOLUME=endora-ci-core-data
ENDORA_CORE_HQ_DATA_VOLUME=endora-ci-core-hq-data
ENDORA_CORE_HQ_TOKEN_VOLUME=endora-ci-core-hq-token
ENDORA_CORE_HQ_RUNNER_TOKEN_VOLUME=endora-ci-core-hq-runner-token
ENDORA_AUDIO_DATA_VOLUME=endora-ci-audio-data
ENDORA_AUDIO_TOKEN_VOLUME=endora-ci-audio-token
ENDORA_AUDIO_PIPES_VOLUME=endora-ci-audio-pipes
ENDORA_AUDIO_SECRET_VOLUME=endora-ci-audio-secret
ENDORA_AUDIO_SENDERS_DATA_VOLUME=endora-ci-audio-senders-data
ENDORA_AUDIO_SPOTIFY_LOGIN_VOLUME=endora-ci-audio-spotify-login
