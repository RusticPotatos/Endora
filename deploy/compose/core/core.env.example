# Endora Core's settings, for compose.yaml beside this file. Copy to `.env` and edit.
# Every value here is a placeholder or a default; nothing personal belongs in a tracked file.

# --- The release ----------------------------------------------------------------------------
# Required. The Core image's tag: a released version (vX.Y.Z → X.Y.Z) or a `sha-<commit>` build.
# Upgrade and roll back by changing it (docs/install.md).
ENDORA_CORE_VERSION=
# The image itself, if you build or mirror it elsewhere.
#ENDORA_CORE_IMAGE=ghcr.io/rusticpotatos/endora-node

# --- Where Core listens -----------------------------------------------------------------------
# The owner API (and Core's built-in screens until the Console cutover). 127.0.0.1 keeps it off
# the network, for example with Console in front.
ENDORA_CORE_BIND=0.0.0.0
ENDORA_CORE_PORT=8787
# 1: self-signed HTTPS, the certificate kept in Core's data volume. 0 only behind something that
# serves HTTPS itself (Console with a certificate, or a reverse proxy).
ENDORA_TLS=1
# The names and addresses people reach this host by, for the certificate (comma separated).
#ENDORA_TLS_SAN=192.168.1.10,endora.example.com

# --- The model --------------------------------------------------------------------------------
# Any OpenAI-compatible endpoint, and the model to ask for. Its key, if it needs one, is added
# after setup in Console's Settings > AI, sealed in Core's own store: never in this file.
ENDORA_MODEL_URL=http://host.docker.internal:11434/v1
ENDORA_MODEL=qwen2.5:7b

# --- HQ (the team engine) -------------------------------------------------------------------
# 1: a scripted demo team, to look around with no model and no runner.
ENDORA_HQ_DEMO=0
ENDORA_HQ_TICK_SECONDS=30

# --- The runner (profile `workers`, off unless named) -----------------------------------------
# It holds Docker's socket (root on this host): read the trust boundary in compose.yaml first.
# Turns at once; each worker gets 256 MB, one CPU and 128 processes at most.
ENDORA_RUNNER_CAPACITY=2

# --- Your day -------------------------------------------------------------------------------
# A zone name (America/New_York), or minutes from UTC when there is none.
ENDORA_TIME_ZONE=
ENDORA_UTC_OFFSET_MINUTES=0

# --- Endora Audio, optional -----------------------------------------------------------------
# Core's sound tools. Empty: none, and Core works the same. The token is Audio's (32+ chars).
ENDORA_SOUND_URL=
ENDORA_SOUND_TOKEN=

# --- Memory caps ----------------------------------------------------------------------------
ENDORA_NODE_MEMORY=768m
ENDORA_HQ_MEMORY=384m
