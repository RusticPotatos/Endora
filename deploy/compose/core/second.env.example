# A second Endora Core on the same host (ADR 0147, amendment of 8 Nov 2026): the settings that
# keep it apart from the first install. Copy this file to the second install's own folder as
# `.env`, beside core/compose.yaml. It renders and starts as it is: nothing in it has to be set
# (change the values below only to move the port, rename the project or pick another Core build;
# core.env.example documents the rest, and is what the first install uses). Then:
#   docker compose up -d
#   printf '%s\n' "$ENDORA_OWNER_PASSWORD" | docker compose exec -T node endora-core setup   # its own owner
#
# Nothing it names is shared with the first install: its project name, its volumes and its host
# port are its own, and its data starts empty. Do not point these volume names at the first
# install's volumes, or the two share one database and one secrets key. Concurrent installs are
# checked by deploy/compose/check-isolation.sh. Not a bundle: Core alone, beside a bundle or not.

# Its project: containers, its default network and its team network (`endora-core-second_team`)
# are named from this. It must differ from the first install's project (`endora` or `endora-core`).
COMPOSE_PROJECT_NAME=endora-core-second

# A published build, as in core.env.example.
ENDORA_CORE_VERSION=sha-2817ecac1aff216c551dde0a598d00177cc105f9

# Its own host port, on the host's loopback only (the first install uses 8786 and 8787).
ENDORA_TLS=0
ENDORA_CORE_BIND=127.0.0.1
ENDORA_CORE_PORT=8796

# Its own volumes: the node's data, HQ's data and the two token volumes. Names only; the data is
# this install's own.
ENDORA_CORE_DATA_VOLUME=endora-core-second-data
ENDORA_CORE_HQ_DATA_VOLUME=endora-core-second-hq-data
ENDORA_CORE_HQ_TOKEN_VOLUME=endora-core-second-hq-token
ENDORA_CORE_HQ_RUNNER_TOKEN_VOLUME=endora-core-second-hq-runner-token
