# ---- Rust / Cargo ----
# Generated by Cargo; compiled files and executables
debug/
target/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants (mutation testing data)
**/mutants.out*/

# Note: Cargo.lock IS committed — this workspace produces binaries, so a locked
# dependency set is desirable. Do not ignore it.

# ---- Environment / secrets ----
# Local environment files and generated secrets. Never commit these.
.env
.env.*
!.env.example
*.local
secrets/
*.pem
*.key

# ---- Local databases (SQLite) ----
# Local, user-owned data stores. Endora is local-first; these stay out of VCS.
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm

# Docker volume mount for local runs (see `make docker-run`).
/endora-data/

# ---- macOS ----
.DS_Store
.AppleDouble
.LSOverride
._*

# ---- VS Code (local settings only) ----
# Keep shared, checked-in editor config; ignore personal/local settings.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json

# ---- JetBrains (IntelliJ / RustRover) ----
.idea/
*.iml

# ---- Local / personal files (NEVER committed) ----
# Kept in the working tree only: personal seed scripts, exports, and notes.
# Name personal files with a `.local` marker and they will always be ignored.
*.local.sh
*.local.json
*.local.md
/my-life.json

# Local-only compose overrides (host-specific; may contain private IPs)
docker-compose.override.yml
